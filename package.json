{
  "name": "eventhub-playwright-tests",
  "version": "1.0.0",
  "description": "EventHub UI and API test automation with Playwright and TypeScript",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "cross-env HEADLESS=false npx playwright test",
    "test:chromium": "npx playwright test --project=chromium",
    "test:e2e": "npx playwright test --project=chromium",
    "test:p0": "npx playwright test --grep @p0 --project=chromium --project=api",
    "test:api": "npx playwright test tests/api/",
    "test:dev": "cross-env TEST_ENV=dev npx playwright test",
    "test:qa": "cross-env TEST_ENV=qa npx playwright test",
    "test:prod": "cross-env TEST_ENV=prod npx playwright test",
    "report": "npx playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e-testing",
    "api-testing",
    "page-object-model"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/cli": "^0.1.19",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
